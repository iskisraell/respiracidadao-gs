{
  "version": 1,
  "author": "Grupo Perceptron - FIAP 1TIAPZ1",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-potentiometer",
      "id": "mq2_sim",
      "top": -110,
      "left": -150,
      "attrs": { "label": "Sensor Fumaca MQ-2 (ADC)" }
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -120,
      "left": 140,
      "attrs": { "temperature": "28.5", "humidity": "32.0" }
    },
    {
      "type": "wokwi-led",
      "id": "led_verde",
      "top": 120,
      "left": -130,
      "attrs": { "color": "green", "label": "NORMAL" }
    },
    {
      "type": "wokwi-led",
      "id": "led_amarelo",
      "top": 120,
      "left": -60,
      "attrs": { "color": "yellow", "label": "ATENCAO" }
    },
    {
      "type": "wokwi-led",
      "id": "led_vermelho",
      "top": 120,
      "left": 10,
      "attrs": { "color": "red", "label": "CRITICO" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer1",
      "top": 115,
      "left": 110,
      "attrs": { "volume": "0.5" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 195,
      "left": -130,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r2",
      "top": 195,
      "left": -60,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r3",
      "top": 195,
      "left": 10,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "mq2_sim:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "mq2_sim:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "mq2_sim:SIG", "esp:34", "orange", [ "v0" ] ],
    [ "dht1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "dht1:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "dht1:SDA", "esp:15", "blue", [ "v0" ] ],
    [ "esp:26", "led_verde:A", "green", [ "v0" ] ],
    [ "led_verde:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND.1", "black", [ "v0" ] ],
    [ "esp:27", "led_amarelo:A", "gold", [ "v0" ] ],
    [ "led_amarelo:C", "r2:1", "black", [ "v0" ] ],
    [ "r2:2", "esp:GND.1", "black", [ "v0" ] ],
    [ "esp:14", "led_vermelho:A", "red", [ "v0" ] ],
    [ "led_vermelho:C", "r3:1", "black", [ "v0" ] ],
    [ "r3:2", "esp:GND.1", "black", [ "v0" ] ],
    [ "esp:12", "buzzer1:1", "purple", [ "v0" ] ],
    [ "buzzer1:2", "esp:GND.2", "black", [ "v0" ] ]
  ]
}
